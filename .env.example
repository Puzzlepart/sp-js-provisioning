# Copy to .env (gitignored) and fill in. Read by `npm run provision` (debug/provision.ts).
# Never commit a tenant URL, a cookie or a certificate.

# The site reserved for this repository's runs and tests: nothing else writes to it. Used when
# `npm run provision` gets no --site.
INTEGRATION_SITE_URL=https://<tenant>.sharepoint.com/sites/<site-reserved-for-sp-js-provisioning>

# Sign-in, by what is set (or forced with INTEGRATION_AUTH=certificate|cookies):
#  - cookies (local, default): as PP365's e2e user (E2E_USERNAME in prosjektportalen365/e2e/.env),
#    with the session its Playwright sign-in left. That account must be a site collection
#    administrator of the site above (the tests and cleanup delete site groups; `provision` alone
#    needs an owner). Create or renew the session (about every two days) with
#    `npx playwright test --project=setup` in prosjektportalen365/e2e. Relative to the repo root.
# INTEGRATION_COOKIES_FILE=../prosjektportalen365/e2e/.auth/user.json
#  - certificate (CI): as an app, app-only. CI_CERT_BASE64 is the PFX, base64, without a password;
#    it is read in memory and never written to disk. Same variables as PP365's integration tests.
#    SharePoint Online refuses app-only tokens from a client secret.
# CI_TENANT=<tenant>.onmicrosoft.com
# CI_CLIENT_ID=
# CI_CERT_BASE64=
# The user an app-only run acts for: owner of the scratch webs, member in the Security and DataRows
# fixtures. Not needed with cookies (the signed-in user).
# INTEGRATION_USER=<user>@<tenant>.onmicrosoft.com

# Integration tests (npm run test:integration):
#  - fail instead of skip when the site or sign-in is missing (set by test:integration:ci)
# INTEGRATION_STRICT=true
#  - keep the scratch webs to look at them (same as --keep); remove them with npm run cleanup
# INTEGRATION_KEEP=true
#  - one scratch web for the whole run instead of one per suite
# INTEGRATION_SCRATCH=run

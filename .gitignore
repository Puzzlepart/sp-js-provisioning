# Logs
logs
*.log
npm-debug.log*
yarn.lock

# Runtime data
pids
*.pid
*.seed

# Coverage directory used by tools like istanbul
coverage

# node-waf configuration
.lock-wscript

# Dependency directory
node_modules

# generated folders
testing
debugging

# Optional npm cache directory
.npm

# allow folks to add things to the debug folder, but don't include them in git
debug/*
!debug/debug.ts
!debug/example.ts
!debug/provision.ts
!debug/provision.settings.example.ts
!debug/README.md
!debug/tsconfig.json
!debug/stubs
!debug/stubs/spfx-jsom.ts
# local provisioning runner credentials — never commit
debug/provision.settings.ts

# project settings
settings.js

bower_components

# need to include this for bower to work, but leave this ignored as PRs
# with updates to dist will be disallowed
dist/
lib/

{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "noEmit": true,
    "types": [
      "es6-promise",
      "node"
    ]
  },
  "include": [
    "unit/**/*.ts",
    "contract/**/*.ts",
    "helpers/**/*.ts",
    "fixtures/**/*.ts",
    "integration/**/*.ts",
    "reporters/**/*.ts",
    "types/**/*.d.ts",
    "../src/**/*.ts",
    "../debug/lib/**/*.ts",
    "../debug/provision.ts",
    "../debug/cleanup.ts",
    "../debug/verify.ts",
    "../debug/inspect.ts"
  ]
}

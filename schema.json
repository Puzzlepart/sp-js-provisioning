                        "type": "string"
                    },
                    "type": "array"
                },
                "RemoveExistingContentTypes": {
                    "description": "Remove the content types not bound, on a list made in this setup (created by this provisioner, across its applyTemplate calls). On a list that existed it does nothing.",
                    "type": "boolean"
                },
                "RemoveExistingViews": {
                    "description": "Remove the views the template does not name, on a list made in this setup (created by this provisioner, across its applyTemplate calls), after the template's own exist. Never a personal view, the default view or the view behind a page's list web part. On a list that existed it does nothing (PnP Framework removes on every run).",

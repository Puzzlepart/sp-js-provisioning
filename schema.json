        },
        "IFolder": {
            "description": "A folder to provision inside a list / document library. Provisioned after\nfields, content types and views exist. Creation is idempotent: an existing\nfolder with the same name is left in place and recursion continues into its\nchildren, so re-running the template is safe.",
            "properties": {
                "Folders": {
                    "description": "Optional nested subfolders, created beneath this folder.",
                    "items": {
                        "$ref": "#/definitions/IFolder"
                    },
                    "type": "array"
                },
                "Name": {
                    "description": "Leaf name of the folder (not a path). May contain spaces and Norwegian\ncharacters (å, æ, ø) — written as-is; PnPjs handles URL encoding.",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "IHooks": {
            "properties": {
                "Body": {
                    "description": "The request body as a JSON object; the handler adds its own properties and sends it as JSON.",
                    "type": "object"
                },
                "Headers": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Request headers, by name.",
                    "type": "object"
                },
                "Method": {
                    "type": "string"
                },
                "Title": {
                    "type": "string"
                },
                "Url": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "IListInstance": {
            "properties": {
                "AdditionalSettings": {
                    "additionalProperties": {
                        "type": [
                            "string",
                            "number",
                            "boolean"
                        ]
                    },
                    "properties": {
                        "DefaultContentApprovalWorkflowId": {
                            "type": "string"
                        },
                        "DefaultDisplayFormUrl": {
                            "type": "string"
                        },
                        "DefaultEditFormUrl": {
                            "type": "string"
                        },
                        "DefaultNewFormUrl": {
                            "type": "string"
                        },
                        "Description": {
                            "type": "string"
                        },
                        "Direction": {
                            "type": "string"
                        },
                        "DocumentTemplateUrl": {
                            "type": "string"
                        },
                        "DraftVersionVisibility": {
                            "description": "Reader = 0; Author = 1; Approver = 2.",
                            "type": "number"
                        },
                        "EnableAttachments": {
                            "type": "boolean"
                        },
                        "EnableFolderCreation": {
                            "type": "boolean"
                        },
                        "EnableMinorVersions": {
                            "type": "boolean"
                        },
                        "EnableModeration": {
                            "type": "boolean"
                        },
                        "EnableVersioning": {
                            "type": "boolean"
                        },
                        "ForceCheckout": {
                            "type": "boolean"
                        },
                        "Hidden": {
                            "type": "boolean"
                        },
                        "IrmEnabled": {
                            "type": "boolean"
                        },
                        "IrmExpire": {
                            "type": "boolean"
                        },
                        "IrmReject": {
                            "type": "boolean"
                        },
                        "IsApplicationList": {
                            "type": "boolean"
                        },
                        "NoCrawl": {
                            "type": "boolean"
                        },
                        "OnQuickLaunch": {
                            "type": "boolean"
                        },
                        "Title": {
                            "type": "string"
                        },
                        "ValidationFormula": {
                            "type": "string"
                        },
                        "ValidationMessage": {
                            "type": "string"
                        }
                    },
                    "type": "object"
                },
                "ContentTypeBindings": {
                    "items": {
                        "$ref": "#/definitions/IContentTypeBinding"
                    },
                    "type": "array"
                },
                "ContentTypesEnabled": {
                    "type": "boolean"
                },
                "DataRows": {
                    "$ref": "#/definitions/IDataRows"
                },
                "Description": {
                    "type": "string"
                },
                "FieldRefs": {
                    "items": {
                        "$ref": "#/definitions/IListInstanceFieldReference"
                    },
                    "type": "array"
                },
                "Fields": {
                    "description": "List fields as schema XML. A missing one is created; one that exists is updated in place, never\ndeleted: a widening type change (Text to Note, Lookup or User single to multi) is applied, another type change\nis a warning and leaves it as it is. A new target (a lookup's list, a taxonomy field's term\nset) is applied on a list made in this setup, otherwise a warning that keeps the stored one.",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "Folders": {
                    "items": {
                        "$ref": "#/definitions/IFolder"
                    },
                    "type": "array"
                },
                "RemoveExistingContentTypes": {
                    "description": "Remove the content types not bound, on a list made in this setup (created by this provisioner,\nacross its `applyTemplate` calls). On a list that existed it does nothing.",
                    "type": "boolean"
                },
                "RemoveExistingViews": {
                    "description": "Remove the views the template does not name, on a list made in this setup (created by this\nprovisioner, across its `applyTemplate` calls), after the template's own exist. Never a\npersonal view, the default view or the view behind a page's list web part. On a list that\nexisted it does nothing (PnP Framework removes on every run).",
                    "type": "boolean"
                },
                "Security": {
                    "$ref": "#/definitions/IListSecurity"
                },
                "Template": {
                    "type": "number"
                },
                "Title": {
                    "type": "string"
                },
                "Views": {
                    "items": {
                        "$ref": "#/definitions/IListView"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "IListInstanceFieldReference": {
            "properties": {
                "AdditionalProperties": {

        },
        "IDataRow": {
            "additionalProperties": {},
            "description": "One row: a map of field **internal name** → value. Value shapes by field type:\n- Text / Note / Number / Currency / Choice / Boolean / DateTime: the raw value.\n- MultiChoice: `string[]`.\n- URL: a string, or `{ Url, Description? }`.\n- Lookup / LookupMulti: an item id (number), `{ lookupId }`, or `{ lookupValue }`\n  (resolved against the target list's show field). Multi accepts an array.\n- User / UserMulti: a login/email string, `{ login }`, or a user id. Multi accepts an array.\n- Taxonomy (`TaxonomyFieldType` / `…Multi`): `{ termId, label }` (label required to\n  write the hidden note field). Multi accepts an array of `{ termId, label }`.",
            "type": "object"
        },
        "IDataRows": {
            "description": "Seed data for a list (provisioned after fields/content types/views exist).\n\nRows are upserted: when {@link KeyColumn} is set, an existing item whose\nKeyColumn matches is updated (or skipped, per {@link UpdateBehavior}) instead\nof creating a duplicate — so re-running the template is idempotent. Without a\nKeyColumn every row is added.",
            "properties": {
                "KeyColumn": {
                    "description": "Field internal name used to match existing rows for idempotent upsert.",
                    "type": "string"
                },
                "Rows": {
                    "items": {
                        "$ref": "#/definitions/IDataRow"
                    },
                    "type": "array"
                },
                "UpdateBehavior": {
                    "description": "When a row matches {@link KeyColumn}: `Overwrite` (default) or `Skip`.",
                    "enum": [
                        "Overwrite",
                        "Skip"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "IFeature": {
            "properties": {
                "deactivate": {
                    "type": "boolean"
                },
                "force": {
                    "type": "boolean"
                },
                "id": {

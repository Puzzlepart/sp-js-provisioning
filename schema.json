                "Description": {
                    "type": "string"
                },
                "Members": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array",
                    "description": "Login names (UPN, email or claims) to add as members."
                },
                "OnlyAllowMembersViewMembership": {
                    "type": "boolean"
                },
                "Owner": {
                    "type": "string",
                    "description": "Group owner: an associated group token, a site group title (including this group's own) or a user login name."
                },
                "RequestToJoinLeaveEmailSetting": {
                    "type": "string"
                },
                "Title": {
                    "type": "string",
                    "description": "Group title, unique within the site collection. Supports tokens, e.g. {sitename}."
                }
            },
            "required": [
                "Title"
            ],
            "type": "object"
        },

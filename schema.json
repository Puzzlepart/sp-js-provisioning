        "IWebSecurity": {
            "description": "Web security: site groups, and role inheritance and role assignments on the web itself. Mirrors the PnP provisioning schema Security element. The members inherited from IListSecurity behave as they do for lists, but apply to the web; the root web of a site collection always has unique permissions, so it takes role assignments without BreakRoleInheritance.",
            "properties": {
                "BreakRoleInheritance": {
                    "description": "Break role inheritance before adding role assignments. Only done while it still inherits, so on a re-run CopyRoleAssignments and ClearSubscopes do nothing.",
                    "type": "boolean"
                },
                "ClearSubscopes": {
                    "description": "Clear unique permissions on child objects when breaking inheritance.",
                    "type": "boolean"
                },
                "CopyRoleAssignments": {
                    "description": "Copy the inherited role assignments when breaking inheritance.",
                    "type": "boolean"
                },
                "RoleAssignments": {
                    "items": {
                        "$ref": "#/definitions/IRoleAssignment"
                    },
                    "type": "array"
                },
                "SiteGroups": {
                    "description": "Site groups to create or update. They are provisioned before Lists, so list Security can grant permissions to them.",
                    "items": {
                        "$ref": "#/definitions/ISiteGroup"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },

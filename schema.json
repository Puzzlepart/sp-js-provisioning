                    "type": "string"
                },
                "Required": {
                    "type": "boolean"
                }
            },
            "type": "object"
        },
        "IListSecurity": {
            "description": "List security, applied after the list's data rows. Mirrors the PnP\nprovisioning schema `Security` element.",
            "properties": {
                "BreakRoleInheritance": {
                    "description": "Break role inheritance before adding role assignments. Only done while it still inherits, so on\na re-run `CopyRoleAssignments` and `ClearSubscopes` do nothing.",
                    "type": "boolean"
                },
                "ClearSubscopes": {
                    "description": "Clear unique permissions on child objects when breaking inheritance.",
                    "type": "boolean"
                },
                "CopyRoleAssignments": {
                    "description": "Copy the inherited role assignments when breaking inheritance.",
                    "type": "boolean"
                },
                "RoleAssignments": {
                    "description": "Role assignments to add. Requires `BreakRoleInheritance`, since SharePoint\nrejects role assignments on a list that still inherits permissions;\ninherited assignments are kept only with `CopyRoleAssignments`.",
                    "items": {
                        "$ref": "#/definitions/IRoleAssignment"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "IListView": {
            "properties": {
                "AdditionalSettings": {
                    "properties": {
                        "CustomFormatter": {
                            "description": "The view's formatting, as the JSON text SharePoint stores (column or row formatting, a\ncard or tile layout). SharePoint ignores it when a view is created, so `Lists` sends the\nsettings again right after creating the view.",
                            "type": "string"
                        },
                        "DefaultView": {
                            "type": "boolean"
                        },
                        "Hidden": {
                            "type": "boolean"
                        },
                        "JSLink": {
                            "type": "string"
                        },
                        "Paged": {
                            "type": "boolean"
                        },
                        "RowLimit": {
                            "type": "number"
                        },
                        "Scope": {
                            "enum": [
                                0,
                                1
                            ],
                            "type": "number"
                        },
                        "ViewQuery": {
                            "type": "string"
                        },
                        "ViewType2": {
                            "description": "The view's modern layout: `TILES` for a cards view, `COMPACTLIST`, `KANBAN` (board) or\n`MODERNCALENDAR`. Like `CustomFormatter`, set again right after the view is created.",
                            "enum": [
                                "COMPACTLIST",
                                "KANBAN",
                                "MODERNCALENDAR",
                                "TILES"
                            ],
                            "type": "string"
                        }
                    },
                    "type": "object"
                },
                "PersonalView": {
                    "type": "boolean"
                },
                "Title": {
                    "type": "string"
                },
                "ViewFields": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "INavigation": {
            "description": "The web's navigation. The template owns each collection it names: on every\nrun the collection ends with exactly the template's nodes, in its order. A\nnode whose title is already there at the same level is kept as it is (id,\nURL, audiences); a missing one is added; a node the template does not\ndeclare is deleted, children and nodes a site owner added included. A\ncollection the template leaves out is not touched. A node SharePoint refuses\n(its URL names no existing file or folder) fails the run and leaves both\ncollections as they were.",
            "properties": {
                "QuickLaunch": {
                    "items": {
                        "$ref": "#/definitions/INavigationNode"
                    },
                    "type": "array"
                },
                "TopNavigationBar": {
                    "items": {
                        "$ref": "#/definitions/INavigationNode"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "INavigationNode": {
            "description": "A navigation node, matched to a stored node at the same level by its exact\ntitle (case included).",
            "properties": {
                "Children": {
                    "description": "The node's children, owned like the collection: without `Children`, a\nkept node loses the children it has.",
                    "items": {
                        "$ref": "#/definitions/INavigationNode"
                    },
                    "type": "array"
                },
                "IgnoreExisting": {
                    "description": "Set the template's `Url` on a node that exists (where it differs). Without\nit an existing node keeps its stored URL, at every level: SharePoint\nupdates a node's URL when its target is renamed, and an owner may have\nchanged it. A title stored more than once gets the template's URL either\nway.",
                    "type": "boolean"
                },
                "Title": {
                    "description": "Title, no tokens. SharePoint returns its own nodes' titles in the signed-in\naccount's language (`Hjem` or `Home`), so such a node matches only for an\naccount with the template's language; otherwise it is added and the\nstored one deleted.",
                    "type": "string"
                },
                "Url": {
                    "description": "Server-relative, web-relative (resolved against the web) or absolute.\nTakes the URL tokens only (`{site}` is the site collection). Used when the\nnode is added, or with `IgnoreExisting`.",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "IPropertyBagEntry": {
            "properties": {
                "Indexed": {
                    "type": "boolean"
                },
                "Key": {
                    "type": "string"
                },
                "Overwrite": {
                    "type": "boolean"
                },
                "Value": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "IRoleAssignment": {
            "description": "A role assignment on a list.",
            "properties": {
                "Principal": {
                    "description": "The principal: a PnP-style token for one of the web's associated groups\n(`{associatedownergroupid}`, `{associatedmembergroupid}`,\n`{associatedvisitorgroupid}`), a principal id, a site group name or a user\nlogin name.",
                    "type": [
                        "string",
                        "number"
                    ]
                },
                "RoleDefinition": {
                    "description": "Role definition name as it exists on the web (localized, e.g. `Full kontroll`\nor `Lese`). The English well-known names (`Full Control`, `Design`, `Edit`,\n`Contribute`, `Read`, `View Only`) are resolved by role type as a fallback.",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "ISiteGroup": {
            "description": "A SharePoint site group. Mirrors the PnP provisioning schema `SiteGroup`\nelement. Groups are matched by title, so re-applying a template updates the\ngroup instead of creating a duplicate.",
            "properties": {
                "AllowMembersEditMembership": {
                    "type": "boolean"
                },
                "AllowRequestToJoinLeave": {
                    "type": "boolean"
                },
                "AutoAcceptRequestToJoinLeave": {
                    "type": "boolean"
                },
                "ClearExistingMembers": {
                    "description": "Remove existing members that are not in `Members`.",
                    "type": "boolean"
                },
                "Description": {
                    "type": "string"
                },
                "Members": {
                    "description": "Members to add, as login names (UPN, email or claims, e.g. an Entra ID\ngroup claim). Each one is ensured on the web before it is added.",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "OnlyAllowMembersViewMembership": {
                    "type": "boolean"
                },
                "Owner": {
                    "description": "Group owner, resolved like a role assignment principal: an associated\ngroup token, a site group title (including this group's own title) or a\nuser login name. Without it SharePoint keeps the provisioning user as owner.",
                    "type": "string"
                },
                "RequestToJoinLeaveEmailSetting": {
                    "type": "string"
                },
                "Title": {
                    "description": "Group title, unique within the site collection. Supports tokens, e.g.\n`{sitename} Styringsgruppe`.",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "ITaxonomy": {
            "properties": {
                "TermGroup": {
                    "$ref": "#/definitions/ITermGroup"
                },
                "TermSets": {
                    "items": {
                        "$ref": "#/definitions/ITermSet"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "ITerm": {
            "properties": {
                "CustomProperties": {
                    "$ref": "#/definitions/Record%3Cstring%2Cstring%3E"
                },
                "Id": {
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "SortOrder": {
                    "type": "number"
                }
            },
            "type": "object"
        },
        "ITermGroup": {
            "properties": {
                "Id": {
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "ITermSet": {
            "properties": {
                "Description": {
                    "type": "string"
                },
                "Id": {
                    "type": "string"
                },
                "IsOpenForTermCreation": {
                    "type": "boolean"
                },
                "Name": {
                    "type": "string"
                },
                "Terms": {
                    "items": {
                        "$ref": "#/definitions/ITerm"
                    },
                    "type": "array"
                },
                "UpdateExistingTerms": {
                    "description": "When true, terms that already exist (matched by Id) get any **missing**\nentries from {@link ITerm.CustomProperties} added. A property that already\nexists on the term is left as-is even if its value differs from the\ntemplate (existing values are never overwritten); the term's name/labels\nare also left untouched. Without this flag existing terms are not modified\nat all. Use it to backfill custom properties (e.g. PhaseSubText /\nPhaseDescription) onto a term set provisioned before those properties\nexisted.",
                    "type": "boolean"
                }
            },
            "type": "object"
        },
        "IWebPart": {
            "properties": {
                "Contents": {
                    "$ref": "#/definitions/IWebPartContents"
                },
                "ListView": {
                    "properties": {
                        "List": {
                            "type": "string"
                        },
                        "View": {
                            "$ref": "#/definitions/IListView"
                        }
                    },
                    "type": "object"
                },
                "Order": {
                    "type": "number"
                },
                "PropertyOverrides": {
                    "items": {
                        "$ref": "#/definitions/IWebPartPropertyOverride"
                    },
                    "type": "array"
                },
                "Title": {
                    "type": "string"
                },
                "Zone": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "IWebPartContents": {
            "properties": {
                "FileSrc": {
                    "type": "string"
                },
                "Xml": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "IWebPartPropertyOverride": {
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "IWebSecurity": {
            "description": "Web security: site groups, and role inheritance and role assignments on the\nweb itself. Mirrors the PnP provisioning schema `Security` element. The\nmembers inherited from {@link IListSecurity} behave as they do for lists, but\napply to the web; the root web of a site collection always has unique\npermissions, so it takes role assignments without `BreakRoleInheritance`.",
            "properties": {
                "BreakRoleInheritance": {
                    "description": "Break role inheritance before adding role assignments. Only done while it still inherits, so on\na re-run `CopyRoleAssignments` and `ClearSubscopes` do nothing.",
                    "type": "boolean"
                },
                "ClearSubscopes": {
                    "description": "Clear unique permissions on child objects when breaking inheritance.",
                    "type": "boolean"
                },
                "CopyRoleAssignments": {
                    "description": "Copy the inherited role assignments when breaking inheritance.",
                    "type": "boolean"
                },
                "RoleAssignments": {
                    "description": "Role assignments to add. Requires `BreakRoleInheritance`, since SharePoint\nrejects role assignments on a list that still inherits permissions;\ninherited assignments are kept only with `CopyRoleAssignments`.",
                    "items": {
                        "$ref": "#/definitions/IRoleAssignment"
                    },
                    "type": "array"
                },
                "SiteGroups": {
                    "description": "Site groups to create or update. They are provisioned before `Lists`, so\nlist `Security` can grant permissions to them.",
                    "items": {

                    "description": "The principal: a PnP-style token for one of the web's associated groups ({associatedownergroupid}, {associatedmembergroupid}, {associatedvisitorgroupid}), a principal id, a site group name or a user login name.",
                    "type": "string"
                },
                "RoleDefinition": {
                    "description": "Role definition name as it exists on the web (localized, e.g. Full kontroll or Lese). The English well-known names (Full Control, Design, Edit, Contribute, Read, View Only) are resolved by role type as a fallback.",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "ISiteGroup": {
            "description": "A SharePoint site group. Mirrors the PnP provisioning schema SiteGroup element. Groups are matched by title, so re-applying a template updates the group instead of creating a duplicate.",

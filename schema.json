        "IListSecurity": {
            "description": "List security, applied after the list's data rows. Mirrors the PnP provisioning schema Security element.",
            "properties": {
                "BreakRoleInheritance": {
                    "description": "Break role inheritance before adding role assignments. Only done while it still inherits, so on a re-run CopyRoleAssignments and ClearSubscopes do nothing.",
                    "type": "boolean"
                },
                "ClearSubscopes": {
                    "description": "Clear unique permissions on child objects when breaking inheritance.",
                    "type": "boolean"
                },
                "CopyRoleAssignments": {
                    "description": "Copy the inherited role assignments when breaking inheritance.",
                    "type": "boolean"
                },
                "RoleAssignments": {
                    "description": "Role assignments to add. Requires BreakRoleInheritance, since SharePoint rejects role assignments on a list that still inherits permissions; inherited assignments are kept only with CopyRoleAssignments.",
                    "items": {
                        "$ref": "#/definitions/IRoleAssignment"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },

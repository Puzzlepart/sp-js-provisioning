{
  "name": "sp-js-provisioning",
  "version": "1.4.0",
  "description": "SharePoint provisioning with pure JavaScript",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "sample-schemas",
    "!sample-schemas/tsconfig.json",
    "schema.json",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "object.omit": "3.0.0",
    "spfx-jsom": "0.6.6",
    "xml-js": "1.6.11"
  },
  "peerDependencies": {
    "@pnp/core": "^4.21.0",
    "@pnp/logging": "^4.21.0",
    "@pnp/queryable": "^4.21.0",
    "@pnp/sp": "^4.21.0"
  },
  "devDependencies": {
    "@azure/msal-node": "7.0.1",
    "@pnp/core": "4.21.0",
    "@pnp/logging": "4.21.0",
    "@pnp/queryable": "4.21.0",
    "@pnp/sp": "4.21.0",
    "@types/es6-promise": "0.0.33",
    "@types/node": "^8.0.28",
    "@types/node-forge": "1.3.14",
    "@types/sharepoint": "^2016.1.2",
    "@types/webpack-env": "1.13.1",
    "@typescript-eslint/eslint-plugin": "4.6.1",
    "@typescript-eslint/parser": "4.6.1",
    "commitlint": "^12.0.1",
    "dotenv": "17.2.3",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "7.2.0",
    "eslint-plugin-prettier": "3.3.1",
    "eslint-plugin-react": "7.22.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-tsdoc": "0.2.11",
    "eslint-plugin-unicorn": "^28.0.2",
    "merge": "1.2.0",
    "merge2": "^1.0.2",
    "node-forge": "1.4.0",
    "prettier": "2.2.1",
    "tsx": "^4.22.4",
    "typescript": "4.0.7"
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint --ext .ts ./src --color --fix && prettier '**/*.ts*' --write --loglevel silent",
    "lint:check": "eslint --ext .ts ./src && prettier \"**/*.ts*\" --check",
    "prepack": "npm run build",
    "test": "tsx --tsconfig tests/tsconfig.json --test \"tests/unit/*.test.ts\"",
    "test:ci": "node -e \"require('node:fs').mkdirSync('test-results',{recursive:true})\" && tsx --tsconfig tests/tsconfig.json --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/unit.xml \"tests/unit/*.test.ts\"",
    "test:coverage": "tsx --enable-source-maps --tsconfig tests/tsconfig.json --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=79 --test-coverage-branches=83 --test-coverage-functions=79 \"tests/unit/*.test.ts\"",
    "check:tenant": "tsx --tsconfig tests/tsconfig.json tests/integration/run.ts reachability --strict",
    "test:integration": "tsx --tsconfig tests/tsconfig.json tests/integration/run.ts",
    "test:integration:ci": "tsx --tsconfig tests/tsconfig.json tests/integration/run.ts --ci",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "check:pack": "node .tasks/check-pack.js",
    "check:secrets": "node .tasks/check-secrets.js",
    "check-skills": "node ./.tasks/check-skills.js",
    "postversion": "tsc && npm publish",
    "provision": "tsx --tsconfig debug/tsconfig.json debug/provision.ts",
    "cleanup": "tsx --tsconfig debug/tsconfig.json debug/cleanup.ts"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "node": true
    },
    "parser": "@typescript-eslint/parser",
    "extends": [
      "prettier",
      "plugin:react/recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:unicorn/recommended"
    ],
    "plugins": [
      "prettier",
      "react-hooks",
      "eslint-plugin-tsdoc",
      "unicorn"
    ],
    "parserOptions": {
      "ecmaVersion": 2018,
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "rules": {
      "@typescript-eslint/no-explicit-any": 0,
      "@typescript-eslint/member-delimiter-style": 0,
      "@typescript-eslint/explicit-function-return-type": 0,
      "@typescript-eslint/explicit-module-boundary-types": 0,
      "@typescript-eslint/no-inferrable-types": 0,
      "react/prop-types": 0,
      "no-inferrable-types": 0,
      "react/display-name": 0,
      "no-compare-neg-zero": 1,
      "no-console": 2,
      "eqeqeq": 1,
      "max-classes-per-file": 1,
      "jsx-quotes": [
        "error",
        "prefer-single"
      ],
      "quotes": [
        "error",
        "single",
        {
          "avoidEscape": true
        }
      ],
      "yoda": 2,
      "require-await": 2,
      "semi": [
        "error",
        "never",
        {}
      ],
      "default-case": 0,
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "warn",
      "tsdoc/syntax": "warn",
      "unicorn/filename-case": 0,
      "unicorn/no-array-reduce": 0,
      "unicorn/no-null": 0,
      "unicorn/prevent-abbreviations": [
        2,
        {
          "checkDefaultAndNamespaceImports": true,
          "checkProperties": false,
          "replacements": {
            "args": false,
            "props": false
          }
        }
      ],
      "unicorn/no-process-exit": 0
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  },
  "eslintIgnore": [
    "src/**/*.d.ts"
  ],
  "prettier": {
    "tabWidth": 2,
    "singleQuote": true,
    "semi": false,
    "arrowParens": "always",
    "printWidth": 80,
    "trailingComma": "none",
    "bracketSpacing": true,
    "jsxBracketSameLine": true,
    "jsxSingleQuote": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Puzzlepart/sp-js-provisioning.git"
  },
  "author": {
    "name": "@olemp"
  },
  "license": "MIT",
  "keywords": [
    "sharepoint",
    "office365",
    "tools",
    "spfx",
    "sharepoint framework",
    "sharepoint provisioning",
    "PnP",
    "Patterns & Practices"
  ],
  "bugs": {
    "url": "https://github.com/Puzzlepart/sp-js-provisioning/issues"
  },
  "homepage": "https://github.com/Puzzlepart/sp-js-provisioning#readme",
  "gitmoji": {
    "build": [
      "🏗️",
      "Make architectural changes"
    ],
    "ci": [
      "👷",
      "Add or update CI build system",
      [
        "integration"
      ]
    ],
    "chore": [
      "💄",
      "Boring chores",
      [
        "boring",
        "stuff"
      ]
    ],
    "docs": [
      "📝",
      "Added or updated documentation",
      [
        "doc",
        "dox"
      ]
    ],
    "feat": [
      "✨",
      "Introduced new features"
    ],
    "fix": [
      "🐛",
      "Fixed a bug",
      [
        "bugfix"
      ]
    ],
    "perf": [
      "⚡",
      "Improved performance"
    ],
    "refactor": [
      "♻️",
      "Refactored code"
    ],
    "revert": [
      "⏪",
      "Reverted changes"
    ],
    "style": [
      "💄",
      "Added or updated the UI and style files"
    ],
    "test": [
      "✅",
      "Added or updated tests"
    ],
    "dev": [
